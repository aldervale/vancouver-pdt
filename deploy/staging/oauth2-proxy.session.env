# Staging oauth2-proxy session for Fly app bcdaylight-staging only.
#
# The GitHub gate is not application middleware. It is oauth2-proxy on the
# staging image. Unauthenticated visits redirect to GitHub with
# approval_prompt=force, which is oauth2-proxy's default and shows the
# consent screen on every login. Refresh is left off (oauth2-proxy's GitHub
# provider does not refresh tokens). The signed-in cookie is 8 hours.
#
# The deploy workflow applies these as machine environment. Environment
# overrides the proxy config file; explicit command-line flags still win,
# and the deploy script rewrites those flags when it can see them.
# An empty approval_prompt is not enough: oauth2-proxy falls back to force.
# Do not put the OAuth client secret or cookie secret in this file.
# This does not change who can sign in.

OAUTH2_PROXY_COOKIE_EXPIRE=8h
OAUTH2_PROXY_COOKIE_REFRESH=0s
OAUTH2_PROXY_APPROVAL_PROMPT=auto
