# CI-only gateway stand-in: no npm, non-root launch user, existing app files.
FROM node:22-alpine
WORKDIR /app
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx \
    && mkdir -p /app/build /app/node_modules/old-development-package \
    && touch /app/build/removed-before-overlay.txt /app/node_modules/old-development-package/leftover.txt
USER node
ENTRYPOINT ["node"]
CMD ["/app/build"]
